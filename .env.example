# ClaimRail configuration
# ────────────────────────────────────────────────────────────────────
# Local dev: copy to .env.local and fill in AUTH_SECRET at minimum.
# Production: set these as environment variables on the Render web
# service. See README.md for the full deployment writeup.
# ────────────────────────────────────────────────────────────────────

# ── Core secrets ─────────────────────────────────────────────────────

# Cryptographic secret used to sign JWT session tokens and derive the
# key for AES-256-GCM secret encryption (Slack webhooks, TOTP secrets).
# REQUIRED. Must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=replace-me-with-a-64-char-hex-string

# Shared secret for the probe cron endpoint. Any caller hitting
# /api/cron/probes must pass `Authorization: Bearer $CRON_SECRET`.
# Generate: openssl rand -hex 32
CRON_SECRET=local-dev-cron-secret

# ── Database ─────────────────────────────────────────────────────────

# Leave DATABASE_URL unset for local dev and the test suite — the app
# falls back to an embedded, WASM-based Postgres-compatible engine
# (PGlite) stored on disk under ./claimrail-data/, no external database
# required. Uncomment ONE of the lines below only if you want to point
# local dev at something else:
#
#   A real Postgres instance (production shape):
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
#   A different PGlite directory (must be a directory, not a file path):
# DATABASE_URL=pglite://./some-other-dir
#
#   A pure in-memory PGlite instance (nothing persists across restarts):
# DATABASE_URL=pglite::memory:

# ── App-wide URL ─────────────────────────────────────────────────────

# Base URL embedded in claim letters and verification emails.
# Local:      http://localhost:3000
# Production: https://claimrail-tj98.onrender.com (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional integrations ────────────────────────────────────────────

# Anthropic API key for real AI SLA parsing. When absent, a
# deterministic heuristic parser is used (good for demos/tests).
ANTHROPIC_API_KEY=

# Slack incoming-webhook URL for breach alerts. Configured per-org via
# the Settings UI — no env var required.
