# ClaimRail configuration
# ────────────────────────────────────────────────────────────────────
# Local dev: copy to .env.local and fill in.
# Production: set these in the Vercel project (+ a subset in Render and
# in GitHub Actions secrets). See DEPLOYMENT.md for the full mapping.
# ────────────────────────────────────────────────────────────────────

# ── Core secrets ─────────────────────────────────────────────────────

# Cryptographic secret used to sign JWT session tokens.
# REQUIRED in production. The server refuses to start without it.
# Must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=replace-me-with-a-64-char-hex-string

# Shared secret for the probe cron endpoint. Any caller hitting
# /api/cron/probes must pass `Authorization: Bearer $CRON_SECRET`.
# Generate: openssl rand -hex 32
CRON_SECRET=local-dev-cron-secret

# ── Database ─────────────────────────────────────────────────────────

# Local dev: a relative/absolute path, or `file:./claimrail.db`.
# Production (Turso):
#   DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<long token from the Turso dashboard>
DATABASE_URL=./claimrail.db
DATABASE_AUTH_TOKEN=

# ── App-wide URL ─────────────────────────────────────────────────────

# Base URL embedded in claim letters and verification emails.
# Local:      http://localhost:3000
# Production: https://claimrail.vercel.app (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional integrations ────────────────────────────────────────────

# Anthropic API key for real AI SLA parsing. When absent, a
# deterministic heuristic parser is used (good for demos/tests).
ANTHROPIC_API_KEY=

# Slack incoming-webhook URL for breach alerts. Configured per-org via
# the Settings UI — no env var required.
