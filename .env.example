# ClaimRail configuration
# Copy to .env.local and fill in

# Cryptographic secret used to sign JWT session tokens.
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-me-with-a-64-char-hex-string

# Database file location (relative to repo root)
DATABASE_URL=./claimrail.db

# Optional: Anthropic API key for real AI SLA parsing.
# Without this, a deterministic heuristic parser is used (good for demos/tests).
ANTHROPIC_API_KEY=

# Probe cron secret — required in the Authorization header when calling /api/cron/probes
CRON_SECRET=local-dev-cron-secret

# Base URL used in claim letters
NEXT_PUBLIC_APP_URL=http://localhost:3000
