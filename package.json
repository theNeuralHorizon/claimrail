{
  "name": "claimrail",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered SaaS SLA credit recovery platform. Automatically detect vendor SLA breaches and recover the money your vendors owe you.",
  "author": "ClaimRail Team",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx lib/db/migrate.ts",
    "db:seed": "tsx lib/db/seed.ts",
    "probe:run": "tsx scripts/run-probes.ts",
    "prepare-data": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.36.4",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "zod": "^3.23.8",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.454.0",
    "recharts": "^2.15.0",
    "date-fns": "^4.1.0",
    "nanoid": "^5.0.9",
    "react-hot-toast": "^2.4.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "@vitest/coverage-v8": "^2.1.5",
    "happy-dom": "^15.11.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
